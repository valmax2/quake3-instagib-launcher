<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quake3InstaGibLauncher.Mac.ViewModels"
             x:Class="Quake3InstaGibLauncher.Mac.Views.KeyBindingsView">

    <ScrollViewer>
        <StackPanel Margin="40,28" MaxWidth="820">
            <TextBlock Text="{DynamicResource Str.KeyBindings.Title}" Classes="title" FontSize="26" Margin="0,0,0,6"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,20" Text="{DynamicResource Str.KeyBindings.Intro}"/>

            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <Grid ColumnDefinitions="60,*,120,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.KeyBindings.ColActive}" Classes="muted"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.KeyBindings.ColCommand}" Classes="muted"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str.KeyBindings.ColKey}" Classes="muted"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Bindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:KeyBindingViewModel">
                                <Grid ColumnDefinitions="60,*,120,Auto" Margin="0,0,0,8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Description}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Command}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="2" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" MaxLength="12" Margin="0,0,10,0"/>
                                    <Button Grid.Column="3" Content="✕" VerticalAlignment="Center"
                                            IsVisible="{Binding !IsBuiltIn}"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveBindingCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{DynamicResource Str.KeyBindings.ResetPresets}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding ResetPresetsCommand}"/>
                </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.KeyBindings.AddCustomHeader}" Classes="section" Margin="0,0,0,10"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" Text="{DynamicResource Str.KeyBindings.AddCustomInfo}"/>
                    <Grid ColumnDefinitions="*,*,100,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.KeyBindings.DescriptionOptional}" Classes="muted" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str.KeyBindings.ColCommand}" Classes="muted" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str.KeyBindings.ColKey}" Classes="muted" Margin="0,0,10,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="{DynamicResource Str.KeyBindings.Add}" Classes="primary" Command="{Binding AddCustomBindingCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
