<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Quake3InstaGibLauncher.Mac.Views"
             xmlns:vm="using:Quake3InstaGibLauncher.Mac.ViewModels"
             xmlns:models="using:Quake3InstaGibLauncher.Core.Models"
             x:Class="Quake3InstaGibLauncher.Mac.Views.MultiplayerSetupView">

    <Grid ColumnDefinitions="*,380">
        <views:MapGalleryView Grid.Column="0" DataContext="{Binding Gallery}"/>

        <Border Grid.Column="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" Margin="18,18,18,0" ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Content="🖥 OSPITA" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SelectHostTabCommand}" Classes.primary="{Binding IsHostTabActive}"/>
                    <Button Grid.Column="1" Content="🔍 CERCA E UNISCITI" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding SelectJoinTabCommand}" Classes.primary="{Binding !IsHostTabActive}"/>
                </Grid>

                <!-- ===================== Scheda OSPITA ===================== -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsHostTabActive}">
                    <StackPanel Margin="18">
                        <TextBlock Text="MULTIPLAYER (host su questo Mac)" Classes="section" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Gallery.SelectedMap.LongName}" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Gallery.SelectedMap.TechnicalName}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16"/>

                        <Border Classes="card" Padding="10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PRESET SERVER" Classes="section" FontSize="11" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding SavedPresets}" SelectedItem="{Binding SelectedPreset}"
                                          HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:ServerPreset">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="6">
                                    <Button Content="Carica" Command="{Binding LoadPresetCommand}" CommandParameter="{Binding SelectedPreset}"/>
                                    <Button Content="Elimina" Command="{Binding DeletePresetCommand}" CommandParameter="{Binding SelectedPreset}"/>
                                </StackPanel>
                                <TextBox Text="{Binding NewPresetName}" Watermark="Nome preset (vuoto = nome server)" Margin="0,0,0,6"/>
                                <Button Content="💾 Salva impostazioni correnti come preset" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding SaveCurrentAsPresetCommand}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Nome server" Classes="muted"/>
                        <TextBox Text="{Binding ServerName}" Margin="0,0,0,10"/>

                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Porta UDP" Classes="muted"/>
                                <TextBox Text="{Binding Port}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Giocatori max" Classes="muted"/>
                                <TextBox Text="{Binding MaxClients}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Password (facoltativa)" Classes="muted"/>
                        <TextBox Text="{Binding Password}" PasswordChar="●" Margin="0,0,0,16"/>

                        <TextBlock Text="MODALITA'" Classes="section" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton Content="Deathmatch (FFA)" GroupName="mpgt" Margin="0,2"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=FreeForAll}"/>
                            <RadioButton Content="Team Deathmatch" GroupName="mpgt" Margin="0,2"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=TeamDeathmatch}"/>
                            <RadioButton Content="Torneo (1v1)" GroupName="mpgt" Margin="0,2"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=Tournament}"/>
                            <RadioButton Content="Cattura la Bandiera (CTF)" GroupName="mpgt" Margin="0,2"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=CaptureTheFlag}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Fraglimit" Classes="muted"/>
                                <TextBox Text="{Binding FragLimit}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Timelimit (min)" Classes="muted"/>
                                <TextBox Text="{Binding TimeLimit}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Fov, StringFormat='FOV: {0}'}" Classes="muted" Margin="0,0,0,2"/>
                        <Slider Minimum="90" Maximum="160" Value="{Binding Fov}" TickFrequency="5" Margin="0,0,0,16"/>

                        <CheckBox Content="Abilita bot di riempimento" IsChecked="{Binding BotsEnabled}" Margin="0,0,0,6"/>
                        <StackPanel IsVisible="{Binding BotsEnabled}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding BotMinPlayers, StringFormat='Giocatori minimi (bot inclusi): {0}'}" Classes="muted"/>
                            <Slider Minimum="0" Maximum="16" Value="{Binding BotMinPlayers}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <TextBlock Text="VISIBILITA' SERVER" Classes="section" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton Content="Solo rete locale (LAN)" GroupName="lan" Margin="0,2" IsChecked="{Binding IsLan}"/>
                            <RadioButton Content="Anche da Internet" GroupName="lan" Margin="0,2" IsChecked="{Binding !IsLan}"/>
                        </StackPanel>

                        <Border Classes="card" Padding="10" Margin="0,0,0,16" IsVisible="{Binding !IsLan}">
                            <StackPanel>
                                <TextBlock Text="Per accettare connessioni da Internet:" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="• Consenti l'app in Firewall di macOS (Preferenze di Sistema → Rete → Firewall)"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="• Inoltra la porta UDP scelta dal router al Mac" Margin="0,4,0,0"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="• Comunica agli amici il tuo IP pubblico e la porta" Margin="0,4,0,0"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap" FontStyle="Italic" Margin="0,8,0,0"
                                           Text="Il launcher non modifica firewall o router automaticamente."/>
                            </StackPanel>
                        </Border>

                        <CheckBox Content="Usa mod InstaGib129 (fs_game)" IsChecked="{Binding UseInstaGibMod}" Margin="0,0,0,6"/>
                        <CheckBox Content="sv_pure 0 (consigliato con mod)" IsChecked="{Binding SvPureOff}" Margin="0,0,0,20"/>

                        <Button Content="AVVIA MULTIPLAYER" Classes="primary" Height="52" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding StartCommand}"/>
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Button Content="📱 Invita via WhatsApp" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding ShareViaWhatsAppCommand}" IsEnabled="{Binding !IsDetectingIp}"/>
                        <TextBlock Text="{Binding InviteStatusMessage}" Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Scheda CERCA E UNISCITI ===================== -->
                <Grid Grid.Row="1" Margin="18" IsVisible="{Binding !IsHostTabActive}" RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="TROVA UNA PARTITA" Classes="section" FontSize="14" Margin="0,0,0,10"/>
                        <Button Content="🔎 Cerca sulla rete locale (LAN)" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6"
                                Command="{Binding SearchLanServersCommand}" IsEnabled="{Binding !IsSearchingServers}"/>
                        <Button Content="🌐 Cerca su Internet (best-effort)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6"
                                Command="{Binding SearchInternetServersCommand}" IsEnabled="{Binding !IsSearchingServers}"/>
                        <TextBlock Text="{Binding SearchStatusMessage}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FoundServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ServerInfo">
                                    <Border Classes="card" Padding="10" Margin="0,0,0,8" Cursor="Hand">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding HostName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="🔒" IsVisible="{Binding NeedsPassword}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding EndPointText}" FontFamily="Consolas,Menlo,monospace" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Classes="muted" Text="{Binding MapName}"/>
                                            <Button Content="Seleziona" Margin="0,6,0,0" Padding="6,2" FontSize="10"
                                                    Command="{Binding $parent[UserControl].DataContext.SelectServerCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedServer.HostName, FallbackValue='Nessun server selezionato'}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Password (se richiesta dal server)" Classes="muted"/>
                        <TextBox Text="{Binding JoinPassword}" PasswordChar="●" Margin="0,0,0,10"/>
                        <Button Content="UNISCITI AL SERVER" Classes="primary" Height="46" FontSize="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding JoinSelectedServerCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
