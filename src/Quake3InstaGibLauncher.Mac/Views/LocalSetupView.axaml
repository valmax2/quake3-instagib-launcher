<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Quake3InstaGibLauncher.Mac.Views"
             xmlns:vm="using:Quake3InstaGibLauncher.Mac.ViewModels"
             x:Class="Quake3InstaGibLauncher.Mac.Views.LocalSetupView">

    <Grid ColumnDefinitions="*,360">
        <views:MapGalleryView Grid.Column="0" DataContext="{Binding Gallery}"/>

        <Border Grid.Column="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="18">
                    <TextBlock Text="PARTITA LOCALE" Classes="section" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Gallery.SelectedMap.LongName}" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Gallery.SelectedMap.TechnicalName}" FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="MODALITA'" Classes="section" Margin="0,0,0,6"/>
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton Content="Deathmatch (FFA)" GroupName="gt" Margin="0,2"
                                     IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=FreeForAll}"/>
                        <RadioButton Content="Team Deathmatch" GroupName="gt" Margin="0,2"
                                     IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=TeamDeathmatch}"/>
                        <RadioButton Content="Torneo (1v1)" GroupName="gt" Margin="0,2"
                                     IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=Tournament}"/>
                        <RadioButton Content="Cattura la Bandiera (CTF)" GroupName="gt" Margin="0,2"
                                     IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumEquals}, ConverterParameter=CaptureTheFlag}"/>
                    </StackPanel>

                    <TextBlock Text="GIOCATORI E BOT" Classes="section" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Text="Giocatori totali (tu incluso)" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalPlayers}" FontWeight="Bold"/>
                    </Grid>
                    <Slider Minimum="2" Maximum="16" Value="{Binding TotalPlayers}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BotCount, StringFormat='→ {0} bot in partita'}" Classes="muted" Margin="0,0,0,14"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Text="Difficolta' bot" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding BotSkill, StringFormat='{}{0}/5'}" FontWeight="Bold"/>
                    </Grid>
                    <Slider Minimum="1" Maximum="5" Value="{Binding BotSkill}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>

                    <TextBlock Text="REGOLE" Classes="section" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Fraglimit" Classes="muted"/>
                            <TextBox Text="{Binding FragLimit}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Timelimit (min)" Classes="muted"/>
                            <TextBox Text="{Binding TimeLimit}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Fov, StringFormat='FOV: {0}'}" Classes="muted" Margin="0,0,0,2"/>
                    <Slider Minimum="90" Maximum="160" Value="{Binding Fov}" TickFrequency="5" Margin="0,0,0,16"/>

                    <CheckBox Content="Usa mod InstaGib129 (fs_game)" IsChecked="{Binding UseInstaGibMod}" Margin="0,0,0,6"/>
                    <CheckBox Content="sv_pure 0 (consigliato con mod)" IsChecked="{Binding SvPureOff}" Margin="0,0,0,20"/>

                    <Button Content="AVVIA PARTITA LOCALE" Classes="primary" Height="52" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding StartCommand}"/>
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
