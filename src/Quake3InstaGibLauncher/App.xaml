<Application x:Class="Quake3InstaGibLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Quake3InstaGibLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmap"/>
            <conv:EnumToBooleanConverter x:Key="EnumToBool"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVis"/>
            <conv:PlayerRatingLabelConverter x:Key="PlayerRatingLabel"/>
            <conv:PlayerRatingBrushConverter x:Key="PlayerRatingBrush"/>
            <conv:StringListJoinConverter x:Key="StringListJoin"/>
            <conv:ThemeImagePathToBitmapConverter x:Key="ThemeImageToBitmap"/>
            <conv:PathEqualsConverter x:Key="PathEquals"/>
            <conv:ObjectEqualsConverter x:Key="ObjectEquals"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg0}"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
