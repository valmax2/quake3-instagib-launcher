    <system:String x:Key="Str.KeyBindings.Intro">Comandi gia' preimpostati (spunta quelli che vuoi usare, cambia il tasto se vuoi) piu' la possibilita' di aggiungerne di tuoi. Vengono applicati automaticamente ad ogni avvio, sia in Locale sia in Multiplayer.</system:String>
    <system:String x:Key="Str.KeyBindings.ColActive">Attivo</system:String>
    <system:String x:Key="Str.KeyBindings.ColCommand">Comando</system:String>
    <system:String x:Key="Str.KeyBindings.ColKey">Tasto</system:String>
    <system:String x:Key="Str.KeyBindings.ResetPresets">Ripristina tasti predefiniti</system:String>
    <system:String x:Key="Str.KeyBindings.AddCustomHeader">AGGIUNGI COMANDO PERSONALIZZATO</system:String>
    <system:String x:Key="Str.KeyBindings.AddCustomInfo">Qualsiasi comando della console Quake III (es. +attack, vstr taunt1, cg_thirdperson 1).</system:String>
    <system:String x:Key="Str.KeyBindings.OpenReference">📋 Elenco comandi e frasi da copiare</system:String>
    <system:String x:Key="Str.KeyBindings.RefWindowTitle">Comandi e frasi copiabili</system:String>
    <system:String x:Key="Str.KeyBindings.RefWindowInfo">Clicca 📋 per copiare il comando, poi incollalo nel campo "Comando" qui sopra per creare un tasto personalizzato.</system:String>
    <system:String x:Key="Str.KeyBindings.RefCopyTooltip">Copia negli appunti</system:String>
    <system:String x:Key="Str.KeyBindings.RefClose">Chiudi</system:String>
    <system:String x:Key="Str.KeyBindings.DescriptionOptional">Descrizione (facoltativa)</system:String>
    <system:String x:Key="Str.KeyBindings.Add">Aggiungi</system:String>
    <system:String x:Key="Str.KeyBindings.ResetSingleTooltip">Ripristina solo questo al valore predefinito</system:String>
    <system:String x:Key="Str.KeyBindings.ConsoleHeader">COMANDI CONSOLE</system:String>
    <system:String x:Key="Str.KeyBindings.ConsoleInfo">Movimento, azioni, voti e cambio arma. Applicati automaticamente ad ogni avvio, sia in Locale sia in Multiplayer.</system:String>
    <system:String x:Key="Str.KeyBindings.ChatHeader">MESSAGGI CHAT RAPIDI</system:String>
    <system:String x:Key="Str.KeyBindings.ChatInfo">Un tasto, un messaggio gia' scritto in chat (say/say_team) — niente da digitare a partita in corso.</system:String>
    <system:String x:Key="Str.KeyBindings.ColMessage">Messaggio</system:String>
    <system:String x:Key="Str.KeyBindings.ColCategory">Tipo</system:String>
    <system:String x:Key="Str.KeyBindings.ChatHint">Per un messaggio di chat personalizzato scrivi il comando come "say Il tuo messaggio" (con tutti scrivi) o "say_team Il tuo messaggio" (solo con la squadra) e scegli "Chat" come tipo.</system:String>

    <!-- ===================== Personaggio ===================== -->
