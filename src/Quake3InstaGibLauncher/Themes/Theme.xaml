<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:Quake3InstaGibLauncher.Services">

    <!-- ============================================================= -->
    <!--  Palette: arena sci-fi industriale, metallo scuro + energia   -->
    <!--  rosso/arancione. Nessuna immagine esterna: solo colori,       -->
    <!--  gradienti e forme vettoriali create per questa interfaccia.   -->
    <!-- ============================================================= -->

    <Color x:Key="Color.Bg0">#0A0B0D</Color>
    <Color x:Key="Color.Bg1">#111317</Color>
    <Color x:Key="Color.Bg2">#181B20</Color>
    <Color x:Key="Color.Panel">#1C2025</Color>
    <Color x:Key="Color.PanelBorder">#2C3138</Color>
    <Color x:Key="Color.Steel">#4A4F58</Color>
    <Color x:Key="Color.SteelLight">#6B717C</Color>

    <Color x:Key="Color.TextPrimary">#F3F1EC</Color>
    <Color x:Key="Color.TextSecondary">#9AA0A8</Color>
    <Color x:Key="Color.TextDim">#5E636B</Color>

    <Color x:Key="Color.Accent">#FF5A1F</Color>
    <Color x:Key="Color.AccentBright">#FF8A3D</Color>
    <Color x:Key="Color.AccentDark">#B33A10</Color>
    <Color x:Key="Color.Energy">#E0202B</Color>
    <Color x:Key="Color.EnergyBright">#FF3B47</Color>

    <Color x:Key="Color.Success">#3DDC84</Color>
    <Color x:Key="Color.Danger">#FF4B4B</Color>
    <Color x:Key="Color.Warning">#FFC24B</Color>

    <SolidColorBrush x:Key="Brush.Bg0" Color="{StaticResource Color.Bg0}"/>
    <SolidColorBrush x:Key="Brush.Bg1" Color="{StaticResource Color.Bg1}"/>
    <SolidColorBrush x:Key="Brush.Bg2" Color="{StaticResource Color.Bg2}"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}"/>
    <SolidColorBrush x:Key="Brush.Steel" Color="{StaticResource Color.Steel}"/>
    <SolidColorBrush x:Key="Brush.SteelLight" Color="{StaticResource Color.SteelLight}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}"/>
    <SolidColorBrush x:Key="Brush.Energy" Color="{StaticResource Color.Energy}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>

    <!-- Colore testo dei pulsanti "primary"/"hero" (accento pieno), personalizzabile dalla
         schermata Personalizza interfaccia. Default bianco. -->
    <SolidColorBrush x:Key="Brush.ButtonPrimaryText" Color="White"/>

    <!-- Sfondo dei pulsanti standard: di norma uguale a Brush.Panel, ma ThemeService lo
         sostituisce con un ImageBrush se l'utente carica un'immagine di sfondo per i pulsanti
         in Personalizza interfaccia. Tenuto separato da Brush.Panel cosi' l'immagine non si
         applica anche alle card/pannelli. -->
    <SolidColorBrush x:Key="Brush.ButtonBackground" Color="{StaticResource Color.Panel}"/>

    <!-- Sfondo dell'intera finestra come immagine: null finche' l'utente non ne carica una in
         Personalizza interfaccia (Rectangle.Fill=null equivale a "nessun riempimento", nessun
         errore). Disegnato dietro a tutti i contenuti in MainWindow.xaml. -->
    <SolidColorBrush x:Key="Brush.WindowBackgroundImage" Color="Transparent"/>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Energy}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Bg2}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.Bg1}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeaderGlow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FF5A1F" Offset="0"/>
        <GradientStop Color="#33FF5A1F" Offset="0.5"/>
        <GradientStop Color="#00FF5A1F" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================= -->
    <!--  Tipografia                                                    -->
    <!-- ============================================================= -->

    <FontFamily x:Key="Font.Display">Segoe UI Black</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="LineHeight" Value="42"/>
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentBright}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============================================================= -->
    <!--  Pulsanti                                                      -->
    <!-- ============================================================= -->

    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Il testo del pulsante va a capo invece di essere tagliato dagli angoli arrotondati
             del Border quando piu' lungo della larghezza disponibile (es. pulsanti con etichette
             lunghe o finestra ridimensionata piu' stretta). -->
        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>

                        <!-- Stile "Rialzato" (Personalizza interfaccia): ombra permanente per un effetto 3D. -->
                        <DataTrigger Binding="{Binding Source={x:Static services:ButtonStyleState.Instance}, Path=CurrentMode}" Value="Raised">
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" BlurRadius="6" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <!-- Stile "Bagliore" (Personalizza interfaccia): alone colorato al passaggio del mouse. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static services:ButtonStyleState.Instance}, Path=CurrentMode}" Value="Glow"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Color.AccentBright}" ShadowDepth="0" BlurRadius="20" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <!-- Brush.PrimaryButtonBackground = immagine personalizzata se caricata in Personalizza
             interfaccia, altrimenti il gradiente arancione originale (vedi ThemeService.Apply). -->
        <Setter Property="Background" Value="{DynamicResource Brush.PrimaryButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ButtonPrimaryText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Btn.Hero" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Padding" Value="28,22"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============================================================= -->
    <!--  Input                                                         -->
    <!-- ============================================================= -->

    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg1}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.AccentBright}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Input.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Input.Slider" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Steel}"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- ComboBox completamente ritemplato: lo stile "Input.ComboBox" di base (solo Background/
         Foreground) non basta perche' il popup a tendina di WPF di default usa i colori di sistema
         di Windows (sfondo chiaro), ignorando i Setter su Background/Foreground del ComboBox
         stesso: risultato testo chiaro su sfondo chiaro, illeggibile. Qui sia il "box" chiuso sia
         il popup aperto sia le singole voci sono ridisegnati con i colori scuri dell'app. -->
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg1}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{StaticResource Brush.Bg1}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Panel}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Brush.TextSecondary}"
                                              HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource Brush.Bg1}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" CornerRadius="3">
                                <ScrollViewer SnapsToDevicePixels="True" Margin="2">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= -->
    <!--  Pannelli / card                                               -->
    <!-- ============================================================= -->

    <Style x:Key="Panel.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="ScrollBar.Themed" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
    </Style>

</ResourceDictionary>
