<UserControl x:Class="Quake3InstaGibLauncher.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28" MaxWidth="820">
            <TextBlock Text="{DynamicResource Str.Players.Title}" Style="{StaticResource Text.Title}" FontSize="28" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,20"
                       Text="{DynamicResource Str.Players.Intro}"/>

            <!-- ===================== Aggiungi manualmente ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Players.AddHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.Players.NameLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str.Players.RatingLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewPlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.TextBox}" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableRatings}" SelectedItem="{Binding NewPlayerRating}"
                                  Style="{StaticResource Input.ComboBox}" Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PlayerRatingLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Str.Players.Add}" Style="{StaticResource Btn.Primary}" Command="{Binding AddPlayerCommand}"/>
                    </Grid>
                    <Button Content="{DynamicResource Str.Players.ShareGamertag}" Style="{StaticResource Btn.Base}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding ShareGamertagViaWhatsAppCommand}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Elenco ===================== -->
            <TextBlock Text="{Binding Players.Count, StringFormat={StaticResource Str.Players.ListFormat}}" Style="{StaticResource Text.Section}" Margin="0,4,0,10"/>

            <TextBlock Style="{StaticResource Text.Muted}" FontStyle="Italic" Margin="0,0,0,10"
                       Text="{DynamicResource Str.Players.EmptyHint}"
                       Visibility="{Binding Players.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Invert, FallbackValue=Collapsed}"/>

            <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="3" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                Background="{Binding Rating, Converter={StaticResource PlayerRatingBrush}}">
                                            <TextBlock Text="{Binding Rating, Converter={StaticResource PlayerRatingLabel}}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,8" FontSize="11" Text="{Binding SightingSummary}"/>
                                    <TextBlock Text="{DynamicResource Str.Players.NotesLabel}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Input.TextBox}"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="70"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableRatings, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Rating}" Style="{StaticResource Input.ComboBox}" MinWidth="120" Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource PlayerRatingLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="{DynamicResource Str.Players.Remove}" Style="{StaticResource Btn.Base}"
                                            Command="{Binding DataContext.RemovePlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
