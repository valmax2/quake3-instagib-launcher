<UserControl x:Class="Quake3InstaGibLauncher.Views.MultiplayerSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Quake3InstaGibLauncher.Views"
             xmlns:models="clr-namespace:Quake3InstaGibLauncher.Core.Models;assembly=Quake3InstaGibLauncher.Core"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800">

    <UserControl.Resources>
        <Style x:Key="Btn.Tab" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <views:MapGalleryView Grid.Column="0" DataContext="{Binding Gallery}"/>

        <!-- ===================== Pannello multiplayer ===================== -->
        <Border Grid.Column="1" Background="{StaticResource Brush.Bg1}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selettore Ospita / Cerca -->
                <Grid Grid.Row="0" Margin="18,18,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource Str.Multiplayer.HostTab}" Margin="0,0,4,0"
                            Command="{Binding SelectHostTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHostTabActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="{DynamicResource Str.Multiplayer.JoinTab}" Margin="4,0,0,0"
                            Command="{Binding SelectJoinTabCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHostTabActive}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- ===================== Scheda OSPITA ===================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsHostTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="18">
                        <TextBlock Text="{DynamicResource Str.Multiplayer.HostTitle}" Style="{StaticResource Text.Section}" FontSize="14" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Gallery.SelectedMap.LongName, FallbackValue='Nessuna mappa selezionata'}" Style="{StaticResource Text.Body}" FontWeight="Bold" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Gallery.SelectedMap.TechnicalName}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,16"/>

                        <!-- Preset -->
                        <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.Multiplayer.ServerPresets}" Style="{StaticResource Text.Section}" FontSize="11" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding SavedPresets}" SelectedItem="{Binding SelectedPreset}"
                                          Style="{StaticResource Input.ComboBox}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{DynamicResource Str.Multiplayer.LoadPreset}" Style="{StaticResource Btn.Base}" Margin="0,0,6,0"
                                            Command="{Binding LoadPresetCommand}" CommandParameter="{Binding SelectedPreset}"/>
                                    <Button Content="{DynamicResource Str.Multiplayer.DeletePreset}" Style="{StaticResource Btn.Base}"
                                            Command="{Binding DeletePresetCommand}" CommandParameter="{Binding SelectedPreset}"/>
                                </StackPanel>
                                <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,6">
                                    <TextBox.ToolTip>
                                        <TextBlock Text="{DynamicResource Str.Multiplayer.PresetNameTooltip}"/>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <Button Content="{DynamicResource Str.Multiplayer.SavePreset}" Style="{StaticResource Btn.Base}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding SaveCurrentAsPresetCommand}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource Str.Multiplayer.ServerName}" Style="{StaticResource Text.Muted}"/>
                        <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Str.Common.Port}" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource Str.Common.MaxPlayers}" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding MaxClients, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.Common.PasswordOptional}" Style="{StaticResource Text.Muted}"/>
                        <PasswordBox x:Name="PasswordInput" Background="{StaticResource Brush.Bg1}" Foreground="{StaticResource Brush.TextPrimary}"
                                     BorderBrush="{StaticResource Brush.PanelBorder}" Padding="8,6" Margin="0,0,0,16"
                                     PasswordChanged="OnPasswordChanged"/>

                        <TextBlock Text="{DynamicResource Str.Common.ModeLabel}" Style="{StaticResource Text.Section}" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton Content="{DynamicResource Str.Common.GameModeFfa}" GroupName="mpgt" Margin="0,2" Foreground="{StaticResource Brush.TextPrimary}"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:GameType.FreeForAll}}"/>
                            <RadioButton Content="{DynamicResource Str.Common.GameModeTeam}" GroupName="mpgt" Margin="0,2" Foreground="{StaticResource Brush.TextPrimary}"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:GameType.TeamDeathmatch}}"/>
                            <RadioButton Content="{DynamicResource Str.Common.GameModeTournament}" GroupName="mpgt" Margin="0,2" Foreground="{StaticResource Brush.TextPrimary}"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:GameType.Tournament}}"/>
                            <RadioButton Content="{DynamicResource Str.Common.GameModeCtf}" GroupName="mpgt" Margin="0,2" Foreground="{StaticResource Brush.TextPrimary}"
                                         IsChecked="{Binding SelectedGameType, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:GameType.CaptureTheFlag}}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Str.Common.FragLimit}" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding FragLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource Str.Common.TimeLimitMin}" Style="{StaticResource Text.Muted}"/>
                                <TextBox Text="{Binding TimeLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Fov, StringFormat={StaticResource Str.Common.FovFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                        <Slider Minimum="90" Maximum="160" Value="{Binding Fov}" Style="{StaticResource Input.Slider}" TickFrequency="5" Margin="0,0,0,16"/>

                        <CheckBox Content="{DynamicResource Str.Multiplayer.BotsEnable}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding BotsEnabled}" Margin="0,0,0,6"/>
                        <StackPanel Visibility="{Binding BotsEnabled, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <TextBlock Text="{Binding BotMinPlayers, StringFormat={StaticResource Str.Multiplayer.MinPlayersFormat}}" Style="{StaticResource Text.Muted}"/>
                            <Slider Minimum="0" Maximum="16" Value="{Binding BotMinPlayers}" Style="{StaticResource Input.Slider}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Str.Multiplayer.Visibility}" Style="{StaticResource Text.Section}" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton Content="{DynamicResource Str.Multiplayer.LanOnly}" GroupName="lan" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,2"
                                         IsChecked="{Binding IsLan}"/>
                            <RadioButton Content="{DynamicResource Str.Multiplayer.AlsoInternet}" GroupName="lan" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,2"
                                         IsChecked="{Binding IsLan, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>

                        <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,16"
                                Visibility="{Binding IsLan, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.Multiplayer.InternetInfoTitle}" Style="{StaticResource Text.Body}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                                <!-- Riga firewall: sostituisce il vecchio promemoria statico con lo stato REALE controllato
                                     (vedi FirewallStatusService). Se gia' consentito, un segno di spunta verde invece di
                                     ripetere un'istruzione gia' fatta; se non lo e', l'istruzione originale + un pulsante
                                     per ricontrollare dopo averlo sistemato a mano; se non determinabile, il testo generico. -->
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Success}"
                                           Visibility="{Binding FirewallStatusKnownAllowed, Converter={StaticResource BoolToVis}}"
                                           Text="{DynamicResource Str.Multiplayer.FirewallAlreadyAllowed}"/>
                                <StackPanel Visibility="{Binding FirewallStatusNeedsAction, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{DynamicResource Str.Multiplayer.InternetInfo1}"/>
                                    <Button Content="{DynamicResource Str.Multiplayer.FirewallRecheck}" Style="{StaticResource Btn.Base}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding RefreshFirewallStatusCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{DynamicResource Str.Multiplayer.InternetInfo1}"
                                           Visibility="{Binding FirewallStatusUnknown, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{DynamicResource Str.Multiplayer.InternetInfo2}" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{DynamicResource Str.Multiplayer.InternetInfo3}" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,8,0,0"
                                           Text="{DynamicResource Str.Multiplayer.InternetInfo4}"/>
                            </StackPanel>
                        </Border>

                        <CheckBox Content="{DynamicResource Str.Common.UseInstaGib}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding UseInstaGibMod}" Margin="0,0,0,6"/>
                        <CheckBox Content="{DynamicResource Str.Common.SvPureOff}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding SvPureOff}" Margin="0,0,0,20"/>

                        <Button Content="{DynamicResource Str.Multiplayer.StartButton}" Style="{StaticResource Btn.Primary}" Height="52" FontSize="15"
                                Command="{Binding StartCommand}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Button Content="{DynamicResource Str.Multiplayer.WhatsAppInvite}" Style="{StaticResource Btn.Base}" Margin="0,10,0,0"
                                Command="{Binding ShareViaWhatsAppCommand}" IsEnabled="{Binding IsDetectingIp, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{Binding InviteStatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Scheda CERCA E UNISCITI ===================== -->
                <Grid Grid.Row="1" Margin="18" Visibility="{Binding IsHostTabActive, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str.Multiplayer.FindMatch}" Style="{StaticResource Text.Section}" FontSize="14" Margin="0,0,0,10"/>
                        <Button Content="{DynamicResource Str.Multiplayer.SearchLan}" Style="{StaticResource Btn.Primary}" Margin="0,0,0,6"
                                Command="{Binding SearchLanServersCommand}" IsEnabled="{Binding IsSearchingServers, Converter={StaticResource InverseBool}}"/>
                        <Button Content="{DynamicResource Str.Multiplayer.SearchInternet}" Style="{StaticResource Btn.Base}" Margin="0,0,0,6"
                                Command="{Binding SearchInternetServersCommand}" IsEnabled="{Binding IsSearchingServers, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{Binding SearchStatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Expander Header="{DynamicResource Str.Multiplayer.FiltersHeader}" Foreground="{StaticResource Brush.AccentBright}" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Str.Multiplayer.FilterModeHint}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="{DynamicResource Str.Common.GameModeFfa}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterFfa}" Margin="0,0,12,0"/>
                                    <CheckBox Content="{DynamicResource Str.Common.GameModeTeam}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterTeam}" Margin="0,0,12,0"/>
                                    <CheckBox Content="{DynamicResource Str.Multiplayer.FilterTournament}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterTournament}" Margin="0,0,12,0"/>
                                    <CheckBox Content="CTF" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterCtf}"/>
                                </WrapPanel>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.FilterInstaGibOnly}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterInstaGibOnly}" Margin="0,0,0,6"/>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.FilterHideFull}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterHideFull}" Margin="0,0,0,6"/>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.FilterHideEmpty}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterHideEmpty}" Margin="0,0,0,6"/>
                                <CheckBox Content="{Binding ServerMaxPingMs, StringFormat={StaticResource Str.Multiplayer.FilterMaxPingFormat}}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterLimitPing}" Margin="0,0,0,2"/>
                                <Slider Minimum="20" Maximum="400" Value="{Binding ServerMaxPingMs}" Style="{StaticResource Input.Slider}" TickFrequency="10"
                                        IsEnabled="{Binding ServerFilterLimitPing}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.SortByPlayers}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerSortByPlayers}" Margin="0,0,0,6"/>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.FilterKnownOnly}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterKnownPlayersOnly}" Margin="0,0,0,6"/>
                                <CheckBox Content="{DynamicResource Str.Multiplayer.FilterHideBotOnly}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding ServerFilterHideBotOnly}"/>
                                <TextBlock Text="{DynamicResource Str.Multiplayer.FilterHideBotOnlyHint}" Style="{StaticResource Text.Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Button Content="{DynamicResource Str.Multiplayer.LoadPlayers}" Style="{StaticResource Btn.Base}" Margin="0,8,0,0"
                                Command="{Binding RefreshPlayerListsCommand}" IsEnabled="{Binding IsLoadingPlayerLists, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{Binding PlayerListStatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ServerInfo}">
                                    <Border Padding="10" Margin="0,0,0,8" Cursor="Hand" ToolTip="{DynamicResource Str.Multiplayer.DoubleClickJoinTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Panel.Card}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasKnownPlayers}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                    <!-- Server attualmente selezionato: bordo pieno + sfondo leggermente diverso, cosi'
                                                         si vede subito quale riga e' selezionata (prima non c'era alcun segnale visivo). -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ObjectEquals}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedServer" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                        <Setter Property="Background" Value="{StaticResource Brush.Bg2}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.SelectAndJoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HostName}" Style="{StaticResource Text.Body}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="🔒" Margin="0,0,4,0" Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Foreground="{StaticResource Brush.Success}" FontSize="11">
                                                        <Run Text="{Binding PingMs, Mode=OneWay}"/>
                                                        <Run Text=" ms"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding EndPointText}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource Brush.TextDim}"/>
                                            <TextBlock Style="{StaticResource Text.Muted}">
                                                <Run Text="{Binding MapName, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Players, Mode=OneWay}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding MaxPlayers, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ModName, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Umani vs bot (disponibile solo dopo "Carica giocatori"): distingue i server con soli
                                                 bot da quelli con avversari veri, il dato che il browser di gioco non mostra da solo. -->
                                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding PlayerListLoaded, Converter={StaticResource BoolToVis}}">
                                                <Run Text="{Binding HumanPlayerCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource Str.Multiplayer.HumansLabel}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding BotPlayerCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource Str.Multiplayer.BotsLabel}"/>
                                            </TextBlock>

                                            <!-- Giocatori conosciuti trovati in questo server -->
                                            <TextBlock Foreground="{DynamicResource Brush.AccentBright}" FontWeight="Bold" FontSize="12" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" Visibility="{Binding HasKnownPlayers, Converter={StaticResource BoolToVis}}">
                                                <Run Text="{DynamicResource Str.Multiplayer.KnownHereFormat}"/>
                                                <Run Text="{Binding MatchedKnownPlayers, Mode=OneWay, Converter={StaticResource StringListJoin}}"/>
                                            </TextBlock>

                                            <!-- Elenco completo giocatori (dopo "Carica giocatori"): clic per salvare -->
                                            <ItemsControl ItemsSource="{Binding PlayerNames}" Margin="0,6,0,0"
                                                          Visibility="{Binding PlayerListLoaded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Btn.Icon}" Padding="6,3" Margin="0,0,6,4" FontSize="11"
                                                                ToolTip="{DynamicResource Str.Multiplayer.RememberPlayerTooltip}"
                                                                Command="{Binding DataContext.RememberPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedServer.HostName, FallbackValue='Nessun server selezionato', StringFormat={StaticResource Str.Multiplayer.SelectedFormat}}"
                                   Style="{StaticResource Text.Body}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource Str.Multiplayer.PasswordIfNeeded}" Style="{StaticResource Text.Muted}"/>
                        <PasswordBox x:Name="JoinPasswordInput" Background="{StaticResource Brush.Bg1}" Foreground="{StaticResource Brush.TextPrimary}"
                                     BorderBrush="{StaticResource Brush.PanelBorder}" Padding="8,6" Margin="0,0,0,10"
                                     PasswordChanged="OnJoinPasswordChanged"/>
                        <Button Content="{DynamicResource Str.Multiplayer.JoinButton}" Style="{StaticResource Btn.Primary}" Height="46" FontSize="14"
                                Command="{Binding JoinSelectedServerCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
