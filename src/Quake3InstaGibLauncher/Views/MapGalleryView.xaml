<UserControl x:Class="Quake3InstaGibLauncher.Views.MapGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Quake3InstaGibLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance vm:MapGalleryPanelViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="MapCardTemplate" DataType="{x:Type vm:MapCardViewModel}">
            <Border Width="220" Height="230" Margin="8" CornerRadius="6" BorderThickness="2" Cursor="Hand"
                    Background="{StaticResource Brush.Panel}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedForRotation}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Anteprima o segnaposto vettoriale -->
                    <Grid ClipToBounds="True">
                        <Image Source="{Binding PreviewPath, Converter={StaticResource ImagePathToBitmap}}" Stretch="UniformToFill"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
                        <Grid Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Rectangle Fill="{StaticResource Brush.Bg2}"/>
                            <Path Data="M0,0 L20,0 L0,20 Z M40,0 L60,0 L20,40 M80,0 L100,0 L40,60"
                                  Stretch="Uniform" Fill="{StaticResource Brush.Steel}" Opacity="0.3" Stroke="{StaticResource Brush.Steel}"/>
                            <TextBlock Text="⛨" FontSize="34" Foreground="{StaticResource Brush.Steel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Badge sorgente -->
                        <Border Background="#B3000000" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="{StaticResource Brush.TextSecondary}"/>
                        </Border>

                        <!-- Stella preferiti -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Style="{StaticResource Btn.Icon}" Padding="4"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock FontSize="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="☆"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="★"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Ultima mappa usata -->
                        <Border Background="{StaticResource Brush.AccentGradient}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                Visibility="{Binding IsRecent, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Str.MapGallery.LastUsedBadge}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Lente anteprima ingrandita -->
                        <Button Content="🔍" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Style="{StaticResource Btn.Icon}" Padding="4"
                                Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="10,6">
                        <TextBlock Text="{Binding LongName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TechnicalName}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextDim}"/>
                        <TextBlock Text="{Binding GameTypesText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <Button Content="{DynamicResource Str.MapGallery.AddToRotation}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,2" FontSize="10"
                                Style="{StaticResource Btn.Base}"
                                Command="{Binding DataContext.AddToRotationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Colonna galleria ===================== -->
        <Grid Grid.Column="0" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Style="{StaticResource Input.TextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10" Height="34">
                <TextBox.Tag>Cerca mappa per nome...</TextBox.Tag>
            </TextBox>

            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <CheckBox Content="FFA" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterFfa}" Margin="0,0,14,0"/>
                <CheckBox Content="Team" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterTeam}" Margin="0,0,14,0"/>
                <CheckBox Content="Tournament" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterTournament}" Margin="0,0,14,0"/>
                <CheckBox Content="CTF" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterCtf}" Margin="0,0,24,0"/>
                <CheckBox Content="baseq3" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterBaseQ3}" Margin="0,0,14,0"/>
                <CheckBox Content="missionpack" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterMissionPack}" Margin="0,0,14,0"/>
                <CheckBox Content="{DynamicResource Str.MapGallery.FilterCustom}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FilterCustom}" Margin="0,0,24,0"/>
                <CheckBox Content="{DynamicResource Str.MapGallery.FavoritesOnly}" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding FavoritesOnly}"/>
            </WrapPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredMaps}" ItemTemplate="{StaticResource MapCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===================== Colonna rotazione ===================== -->
        <Border Grid.Column="1" Background="{StaticResource Brush.Bg1}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource Str.MapGallery.RotationTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RotationMaps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MapCardViewModel}">
                                <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,6" Cursor="Hand" ToolTip="{DynamicResource Str.MapGallery.RotationPreviewTooltip}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding LongName}" Style="{StaticResource Text.Body}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource Btn.Icon}" Padding="3" FontSize="9"
                                                    Command="{Binding DataContext.MoveRotationUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource Btn.Icon}" Padding="3" FontSize="9"
                                                    Command="{Binding DataContext.MoveRotationDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="✕" Style="{StaticResource Btn.Icon}" Padding="3" FontSize="9"
                                                    Command="{Binding DataContext.RemoveFromRotationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding RotationWarning}" Foreground="{StaticResource Brush.Danger}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding RotationWarning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{DynamicResource Str.MapGallery.RotationEmpty}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Visibility="{Binding RotationMaps.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <Button Content="{DynamicResource Str.MapGallery.ClearRotation}" Style="{StaticResource Btn.Base}" Margin="0,8,0,0" Command="{Binding ClearRotationCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Overlay: anteprima ingrandita ===================== -->
        <Border Grid.ColumnSpan="2" Background="#EE0A0B0D" Visibility="{Binding PreviewMap, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePreviewCommand}"/>
            </Border.InputBindings>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800">
                <Border BorderBrush="{StaticResource Brush.AccentBright}" BorderThickness="2" Background="{StaticResource Brush.Bg2}">
                    <Image Source="{Binding PreviewMap.PreviewPath, Converter={StaticResource ImagePathToBitmap}}" MaxHeight="500" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding PreviewMap.LongName}" Style="{StaticResource Text.Title}" FontSize="26" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="{Binding PreviewMap.TechnicalName}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PreviewMap.GameTypesText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="{DynamicResource Str.MapGallery.ClickToClose}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
