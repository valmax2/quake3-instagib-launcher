<Window x:Class="Quake3InstaGibLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quake3InstaGibLauncher.Views"
        xmlns:models="clr-namespace:Quake3InstaGibLauncher.Models"
        xmlns:core="clr-namespace:Quake3InstaGibLauncher.Core.Models;assembly=Quake3InstaGibLauncher.Core"
        Title="Quake III InstaGib Launcher"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource Brush.Bg0}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sfondo personalizzato a immagine (facoltativo): dietro a tutto, sotto la barra di
             navigazione (che resta sempre leggibile con sfondo pieno) ma dietro alle altre
             schermate. Fill=Transparent finche' l'utente non carica un'immagine in Personalizza. -->
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource Brush.WindowBackgroundImage}" IsHitTestVisible="False"/>

        <!-- ===================== Barra di navigazione ===================== -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Bg1}" BorderBrush="{StaticResource Brush.PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand">
                    <StackPanel.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding GoHomeCommand}"/>
                    </StackPanel.InputBindings>
                    <Border Width="10" Height="28" Background="{StaticResource Brush.AccentGradient}" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Str.App.Brand1}" FontFamily="{StaticResource Font.Display}" FontSize="20" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str.App.Brand2}" FontFamily="{StaticResource Font.Body}" FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource Brush.AccentBright}" VerticalAlignment="Center" Margin="6,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Nav.Home}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoHomeCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Local}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoLocalSetupCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Multiplayer}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoMultiplayerSetupCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Settings}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoSettingsCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Diagnostics}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoDiagnosticsCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Help}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoHelpCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Customize}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoCustomizeCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.Players}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoPlayersCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.KeyBindings}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoKeyBindingsCommand}"/>
                        <Button Content="{DynamicResource Str.Nav.PlayerProfile}" Style="{StaticResource Btn.Base}" Padding="12,10" Margin="3,0" Command="{Binding GoPlayerProfileCommand}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Selettore lingua: bandierine vettoriali disegnate (non emoji: gli emoji-bandiera
                         non sono renderizzati come icone su molte versioni di Windows, mostrano solo il
                         codice paese testuale "IT"/"GB"). Piccole ma sempre visibili su qualsiasi PC. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{DynamicResource Str.Language.Tooltip}">
                        <Button Padding="4,3" Margin="0,0,4,0" Cursor="Hand"
                                Command="{Binding SetLanguageCommand}" CommandParameter="{x:Static core:AppLanguage.Italian}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage}" Value="{x:Static core:AppLanguage.Italian}">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="{StaticResource Color.AccentBright}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Style>
                            </Button.Style>
                            <Border Width="22" Height="16" BorderBrush="#33000000" BorderThickness="1" SnapsToDevicePixels="True">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="3" Height="2">
                                        <Rectangle Canvas.Left="0" Width="1" Height="2" Fill="#009246"/>
                                        <Rectangle Canvas.Left="1" Width="1" Height="2" Fill="#FFFFFF"/>
                                        <Rectangle Canvas.Left="2" Width="1" Height="2" Fill="#CE2B37"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>
                        <Button Padding="4,3" Cursor="Hand"
                                Command="{Binding SetLanguageCommand}" CommandParameter="{x:Static core:AppLanguage.English}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage}" Value="{x:Static core:AppLanguage.English}">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="{StaticResource Color.AccentBright}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Style>
                            </Button.Style>
                            <Border Width="22" Height="16" BorderBrush="#33000000" BorderThickness="1" SnapsToDevicePixels="True">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="30" Height="18">
                                        <Rectangle Width="30" Height="18" Fill="#00247D"/>
                                        <Line X1="0" Y1="0" X2="30" Y2="18" Stroke="White" StrokeThickness="4"/>
                                        <Line X1="30" Y1="0" X2="0" Y2="18" Stroke="White" StrokeThickness="4"/>
                                        <Line X1="0" Y1="0" X2="30" Y2="18" Stroke="#CF142B" StrokeThickness="1.6"/>
                                        <Line X1="30" Y1="0" X2="0" Y2="18" Stroke="#CF142B" StrokeThickness="1.6"/>
                                        <Rectangle Canvas.Top="6" Width="30" Height="6" Fill="White"/>
                                        <Rectangle Canvas.Left="12" Width="6" Height="18" Fill="White"/>
                                        <Rectangle Canvas.Top="7.5" Width="30" Height="3" Fill="#CF142B"/>
                                        <Rectangle Canvas.Left="13.5" Width="3" Height="18" Fill="#CF142B"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Donazione PayPal sempre visibile (non solo in Guida): stesso link di
                         HelpVm.PayPalUrl, condiviso tra le due posizioni. Nascosto se il link non
                         e' ancora impostato (HasDonateLink), stessa logica della card in Guida. -->
                    <Button Padding="10,6" Margin="0,0,10,0" Cursor="Hand"
                            Command="{Binding HelpVm.OpenLinkCommand}" CommandParameter="{Binding HelpVm.PayPalUrl}"
                            Visibility="{Binding HelpVm.HasDonateLink, Converter={StaticResource BoolToVis}}"
                            ToolTip="{DynamicResource Str.Help.CreditsDonateInfo}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Base}">
                                <Setter Property="Background" Value="#0070BA"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#005EA6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9" Background="White" Margin="0,0,6,0">
                                <TextBlock Text="P" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="11"
                                           Foreground="#0070BA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"
                                       Text="{DynamicResource Str.Help.CreditsDonateNavLabel}"/>
                        </StackPanel>
                    </Button>

                    <!-- Attiva/disattiva rapido dei suoni UI, senza dover andare in Personalizza. -->
                    <Button Padding="6,4" Margin="0,0,10,0" FontSize="16"
                            Command="{Binding ToggleUiSoundsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                <Setter Property="Content" Value="🔇"/>
                                <Setter Property="ToolTip" Value="Suoni disattivati (clic per attivare)"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UiSoundsEnabled}" Value="True">
                                        <Setter Property="Content" Value="🔊"/>
                                        <Setter Property="ToolTip" Value="Suoni attivi (clic per disattivare)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstallationStatus.IsValid}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Home.InstallationSummary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Banner messaggi ===================== -->
        <Border Grid.Row="1" Padding="16,8" Visibility="{Binding BannerMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#26305C3D"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                            <Setter Property="Background" Value="#334B1A1A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BannerMessage}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource Btn.Icon}" Command="{Binding DismissBannerCommand}"/>
            </Grid>
        </Border>

        <!-- ===================== Contenuto ===================== -->
        <Grid Grid.Row="2">
            <!-- IMPORTANTE: la Visibility di ogni schermata e' ancorata al DataContext della
                 Window (RelativeSource) e non al binding semplice "{Binding CurrentScreen}":
                 quelle schermate impostano ANCHE un DataContext locale (il proprio sotto-ViewModel),
                 e un binding "{Binding CurrentScreen}" senza RelativeSource si risolverebbe contro
                 quel DataContext locale (che non ha una proprieta' CurrentScreen), fallendo in
                 silenzio e lasciando la Visibility al suo valore di default Visible. -->
            <views:HomeView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Home}}"/>
            <views:LocalSetupView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.LocalSetup}}"
                                   DataContext="{Binding LocalSetup}"/>
            <views:MultiplayerSetupView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.MultiplayerSetup}}"
                                         DataContext="{Binding MultiplayerSetup}"/>
            <views:SettingsView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Settings}}"
                                 DataContext="{Binding SettingsVm}"/>
            <views:DiagnosticsView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Diagnostics}}"
                                    DataContext="{Binding Diagnostics}"/>
            <views:HelpView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Help}}"
                             DataContext="{Binding HelpVm}"/>
            <views:CustomizeView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Customize}}"
                                  DataContext="{Binding CustomizeVm}"/>
            <views:PlayersView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.Players}}"
                                DataContext="{Binding PlayersVm}"/>
            <views:KeyBindingsView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.KeyBindings}}"
                                    DataContext="{Binding KeyBindingsVm}"/>
            <views:PlayerProfileView Visibility="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVis}, ConverterParameter={x:Static models:AppScreen.PlayerProfile}}"
                                      DataContext="{Binding PlayerProfileVm}"/>

            <!-- ===================== Overlay: occupato ===================== -->
            <Border Background="#CC0A0B0D" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SCANSIONE IN CORSO" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" FontSize="16"/>
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ===================== Overlay: conferma avvio ===================== -->
            <Border Background="#DD0A0B0D" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Panel.Card}" MaxWidth="640" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Brush.AccentBright}">
                    <StackPanel>
                        <TextBlock Text="RIEPILOGO PARTITA" Style="{StaticResource Text.Section}" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ConfirmSummary}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>

                        <Button Content="Mostra riga di comando avanzata ▾" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Left"
                                Margin="0,14,0,0" Command="{Binding ToggleConfirmAdvancedCommand}"
                                Foreground="{StaticResource Brush.AccentBright}"/>

                        <StackPanel Visibility="{Binding ConfirmShowAdvanced, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <TextBox Text="{Binding ConfirmAdvancedCommand, Mode=OneWay}" Style="{StaticResource Input.TextBox}"
                                     TextWrapping="Wrap" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Content="Copia comando" Style="{StaticResource Btn.Base}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding CopyAdvancedCommandCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Annulla" Style="{StaticResource Btn.Base}" Margin="0,0,10,0" Command="{Binding ConfirmNoCommand}"/>
                            <Button Content="AVVIA" Style="{StaticResource Btn.Primary}" Command="{Binding ConfirmYesCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
