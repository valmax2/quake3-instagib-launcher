<UserControl x:Class="Quake3InstaGibLauncher.Views.CustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Quake3InstaGibLauncher.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28" MaxWidth="820">
            <TextBlock Text="{DynamicResource Str.Customize.Title}" Style="{StaticResource Text.Title}" FontSize="28" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,20"
                       Text="{DynamicResource Str.Customize.Intro}"/>

            <!-- ===================== Palette rapide ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.QuickPalette}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,10" Padding="10,8"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Accent}"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===================== Colori dettagliati ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.ColorsHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="{DynamicResource Str.Customize.AccentMain}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Customize.AccentBright}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding AccentBrightColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="{DynamicResource Str.Customize.Energy}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding EnergyColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Customize.ButtonText}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding ButtonTextColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Str.Customize.WindowBg}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding BackgroundColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource Str.Customize.PanelBg}" Style="{StaticResource Text.Muted}"/>
                            <TextBox Text="{Binding PanelColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Stile pulsanti ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.ButtonStyleHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Str.Customize.StyleFlat}" GroupName="btnstyle" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonStyle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ButtonStyleMode.Flat}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.StyleRaised}" GroupName="btnstyle" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonStyle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ButtonStyleMode.Raised}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.StyleGlow}" GroupName="btnstyle" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonStyle, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ButtonStyleMode.Glow}}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str.Common.PreviewLabel}" Style="{StaticResource Text.Muted}" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Customize.PreviewNormalButton}" Style="{StaticResource Btn.Base}" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource Str.Customize.PreviewMainButton}" Style="{StaticResource Btn.Primary}"/>
                    </StackPanel>

                    <CheckBox Content="{DynamicResource Str.Customize.SoundsToggle}" IsChecked="{Binding UiSoundsEnabled}" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Text.Muted}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{DynamicResource Str.Customize.SoundsInfo}"/>
                </StackPanel>
            </Border>

            <!-- ===================== Emblema animato (Home) ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.EmblemHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>

                    <CheckBox Content="{DynamicResource Str.Customize.RotateEmblem}" IsChecked="{Binding LogoRotationEnabled}" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Str.Customize.PositionVsTitle}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="{DynamicResource Str.Customize.AboveTitle}" GroupName="logopos" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoPos, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoPosition.AboveTitle}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.BehindTitle}" GroupName="logopos" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoPos, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoPosition.BehindTitle}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.Hidden}" GroupName="logopos" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoPos, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoPosition.Hidden}}"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Str.Customize.RotationAxis}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="{DynamicResource Str.Customize.AxisFlat}" GroupName="logoaxis" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoAxis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoRotationAxis.Z}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.AxisVertical}" GroupName="logoaxis" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoAxis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoRotationAxis.Y}}"/>
                        <RadioButton Content="{DynamicResource Str.Customize.AxisHorizontal}" GroupName="logoaxis" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding LogoAxis, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:LogoRotationAxis.X}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LogoSize, StringFormat={StaticResource Str.Customize.SizeFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                    <Slider Minimum="80" Maximum="600" Value="{Binding LogoSize}" Style="{StaticResource Input.Slider}" TickFrequency="20" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding LogoRotationSeconds, StringFormat={StaticResource Str.Customize.SpeedFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                    <Slider Minimum="5" Maximum="300" Value="{Binding LogoRotationSeconds}" Style="{StaticResource Input.Slider}" TickFrequency="5"/>

                    <TextBlock Text="{DynamicResource Str.Customize.SeeInHome}" Style="{StaticResource Text.Muted}" FontStyle="Italic" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Risoluzione import immagini (comune) ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.ImagesHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.Customize.ImagesInfo}"/>
                    <TextBlock Text="{DynamicResource Str.Customize.MaxImportRes}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableMaxResolutions}" SelectedItem="{Binding ImportedImageMaxResolution}"
                              Style="{StaticResource Input.ComboBox}" HorizontalAlignment="Left" MinWidth="140"/>
                </StackPanel>
            </Border>

            <!-- ===================== Logo personalizzato ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.LogoHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.Customize.LogoInfo}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Common.BrowseImageOrGif}" Style="{StaticResource Btn.Base}" Margin="0,0,10,0" Command="{Binding BrowseLogoImageCommand}"/>
                        <Button Content="{DynamicResource Str.Customize.LogoRemove}" Style="{StaticResource Btn.Base}" Command="{Binding ClearLogoImageCommand}"
                                Visibility="{Binding HasLogoImage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LogoImagePath, StringFormat={StaticResource Str.Common.CurrentFileFormat}, FallbackValue={StaticResource Str.Customize.NoLogoFallback}}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource Str.Customize.GifDetected}" Style="{StaticResource Text.Muted}" FontStyle="Italic" Margin="0,4,0,0"
                               Visibility="{Binding LogoImageIsAnimatedGif, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{DynamicResource Str.Common.GalleryHeader}" Style="{StaticResource Text.Muted}" Margin="0,14,0,6"
                               Visibility="{Binding LogoImageHistory.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding LogoImageHistory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="64" Height="48" Margin="0,0,8,8">
                                    <Border CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="2">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectLogoFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PathEquals}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.LogoImagePath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Content="✕" Style="{StaticResource Btn.Icon}" Padding="2" FontSize="9" Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Background="#AA0A0B0D"
                                            Command="{Binding DataContext.RemoveLogoFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===================== Sfondo finestra ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.WindowBgHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Common.BrowseImage}" Style="{StaticResource Btn.Base}" Margin="0,0,10,0" Command="{Binding BrowseBackgroundImageCommand}"/>
                        <Button Content="{DynamicResource Str.Common.Remove}" Style="{StaticResource Btn.Base}" Command="{Binding ClearBackgroundImageCommand}"
                                Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BackgroundImagePath, StringFormat={StaticResource Str.Common.CurrentFileFormat}, FallbackValue={StaticResource Str.Customize.NoWindowBgFallback}}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>

                    <TextBlock Text="{DynamicResource Str.Common.PresetsHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding PresetBackgroundImages.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding PresetBackgroundImages}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="72" Height="54" Margin="0,0,8,8" CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.PanelBorder}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPresetBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Str.Common.GalleryHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding BackgroundImageHistory.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding BackgroundImageHistory}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="64" Height="48" Margin="0,0,8,8">
                                    <Border CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="2">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PathEquals}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.BackgroundImagePath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Content="✕" Style="{StaticResource Btn.Icon}" Padding="2" FontSize="9" Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Background="#AA0A0B0D"
                                            Command="{Binding DataContext.RemoveBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding BackgroundImageOpacity, StringFormat={StaticResource Str.Common.OpacityFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundImageOpacity}" Style="{StaticResource Input.Slider}" TickFrequency="0.05" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Str.Common.FitLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Str.Common.FitFill}" GroupName="bgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding BackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.UniformToFill}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitUniform}" GroupName="bgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding BackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Uniform}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitStretch}" GroupName="bgfit" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding BackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Fill}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Sfondo schermata Home ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.HomeBgHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.Customize.HomeBgInfo}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Common.BrowseImage}" Style="{StaticResource Btn.Base}" Margin="0,0,10,0" Command="{Binding BrowseHomeBackgroundImageCommand}"/>
                        <Button Content="{DynamicResource Str.Common.Remove}" Style="{StaticResource Btn.Base}" Command="{Binding ClearHomeBackgroundImageCommand}"
                                Visibility="{Binding HasHomeBackgroundImage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HomeBackgroundImagePath, StringFormat={StaticResource Str.Common.CurrentFileFormat}, FallbackValue={StaticResource Str.Customize.NoHomeBgFallback}}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>

                    <TextBlock Text="{DynamicResource Str.Common.PresetsHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding PresetBackgroundImages.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding PresetBackgroundImages}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="72" Height="54" Margin="0,0,8,8" CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.PanelBorder}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPresetHomeBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Str.Common.GalleryHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding HomeBackgroundImageHistory.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding HomeBackgroundImageHistory}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="64" Height="48" Margin="0,0,8,8">
                                    <Border CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="2">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectHomeBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PathEquals}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.HomeBackgroundImagePath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Content="✕" Style="{StaticResource Btn.Icon}" Padding="2" FontSize="9" Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Background="#AA0A0B0D"
                                            Command="{Binding DataContext.RemoveHomeBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding HomeBackgroundImageOpacity, StringFormat={StaticResource Str.Common.OpacityFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding HomeBackgroundImageOpacity}" Style="{StaticResource Input.Slider}" TickFrequency="0.05" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Str.Common.FitLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Str.Common.FitFill}" GroupName="homebgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding HomeBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.UniformToFill}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitUniform}" GroupName="homebgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding HomeBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Uniform}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitStretch}" GroupName="homebgfit" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding HomeBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Fill}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== Sfondo pulsanti ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Customize.ButtonBgHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.Common.BrowseImage}" Style="{StaticResource Btn.Base}" Margin="0,0,10,0" Command="{Binding BrowseButtonBackgroundImageCommand}"/>
                        <Button Content="{DynamicResource Str.Common.Remove}" Style="{StaticResource Btn.Base}" Command="{Binding ClearButtonBackgroundImageCommand}"
                                Visibility="{Binding HasButtonBackgroundImage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ButtonBackgroundImagePath, StringFormat={StaticResource Str.Common.CurrentFileFormat}, FallbackValue={StaticResource Str.Customize.NoButtonBgFallback}}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>

                    <TextBlock Text="{DynamicResource Str.Common.PresetsHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding PresetButtonBackgroundImages.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding PresetButtonBackgroundImages}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="72" Height="54" Margin="0,0,8,8" CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="1"
                                        BorderBrush="{StaticResource Brush.PanelBorder}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPresetButtonBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Str.Common.GalleryHeader}" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"
                               Visibility="{Binding ButtonBackgroundImageHistory.Count, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding ButtonBackgroundImageHistory}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="64" Height="48" Margin="0,0,8,8">
                                    <Border CornerRadius="3" ClipToBounds="True" Cursor="Hand" BorderThickness="2">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectButtonBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.PanelBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PathEquals}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.ButtonBackgroundImagePath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Converter={StaticResource ThemeImageToBitmap}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Content="✕" Style="{StaticResource Btn.Icon}" Padding="2" FontSize="9" Width="16" Height="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Background="#AA0A0B0D"
                                            Command="{Binding DataContext.RemoveButtonBackgroundFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ButtonBackgroundImageOpacity, StringFormat={StaticResource Str.Common.OpacityFormat}}" Style="{StaticResource Text.Muted}" Margin="0,0,0,2"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding ButtonBackgroundImageOpacity}" Style="{StaticResource Input.Slider}" TickFrequency="0.05" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource Str.Common.FitLabel}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Str.Common.FitFill}" GroupName="btnbgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.UniformToFill}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitUniform}" GroupName="btnbgfit" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Uniform}}"/>
                        <RadioButton Content="{DynamicResource Str.Common.FitStretch}" GroupName="btnbgfit" Foreground="{StaticResource Brush.TextPrimary}"
                                     IsChecked="{Binding ButtonBackgroundImageFit, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ImageFitMode.Fill}}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str.Common.PreviewLabel}" Style="{StaticResource Text.Muted}" Margin="0,14,0,6"/>
                    <Button Content="{DynamicResource Str.Customize.SampleButton}" Style="{StaticResource Btn.Base}" HorizontalAlignment="Left" Padding="20,10"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Str.Customize.ApplyAndSave}" Style="{StaticResource Btn.Primary}" Margin="0,0,10,0" Command="{Binding ApplyAndSaveCommand}"/>
                <Button Content="{DynamicResource Str.Customize.ResetDefaults}" Style="{StaticResource Btn.Base}" Command="{Binding ResetToDefaultsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
