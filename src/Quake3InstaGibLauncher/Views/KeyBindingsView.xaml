<UserControl x:Class="Quake3InstaGibLauncher.Views.KeyBindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Quake3InstaGibLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1100">

    <UserControl.Resources>
        <DataTemplate x:Key="BindingRowTemplate" DataType="{x:Type vm:KeyBindingViewModel}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Width="50" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Command}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Brush.TextDim}"/>
                </StackPanel>
                <TextBox Grid.Column="2" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"
                         VerticalAlignment="Center" MaxLength="12" Margin="0,0,6,0"/>
                <Button Grid.Column="3" Content="↺" Style="{StaticResource Btn.Icon}" VerticalAlignment="Center" Margin="0,0,4,0"
                        ToolTip="{DynamicResource Str.KeyBindings.ResetSingleTooltip}"
                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.ResetSingleBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
                <Button Grid.Column="4" Content="✕" Style="{StaticResource Btn.Icon}" VerticalAlignment="Center"
                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Command="{Binding DataContext.RemoveBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28" MaxWidth="860">
            <TextBlock Text="{DynamicResource Str.KeyBindings.Title}" Style="{StaticResource Text.Title}" FontSize="28" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,20"
                       Text="{DynamicResource Str.KeyBindings.Intro}"/>

            <!-- ===================== Comandi console ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.KeyBindings.ConsoleHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.KeyBindings.ConsoleInfo}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.KeyBindings.ColActive}" Style="{StaticResource Text.Muted}" Width="50"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.KeyBindings.ColCommand}" Style="{StaticResource Text.Muted}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str.KeyBindings.ColKey}" Style="{StaticResource Text.Muted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ConsoleBindings}" ItemTemplate="{StaticResource BindingRowTemplate}"/>
                </StackPanel>
            </Border>

            <!-- ===================== Messaggi chat ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.KeyBindings.ChatHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.KeyBindings.ChatInfo}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.KeyBindings.ColActive}" Style="{StaticResource Text.Muted}" Width="50"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.KeyBindings.ColMessage}" Style="{StaticResource Text.Muted}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str.KeyBindings.ColKey}" Style="{StaticResource Text.Muted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChatBindings}" ItemTemplate="{StaticResource BindingRowTemplate}"/>
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource Str.KeyBindings.ResetPresets}" Style="{StaticResource Btn.Base}" HorizontalAlignment="Left" Margin="0,0,0,16"
                    Command="{Binding ResetPresetsCommand}"/>

            <!-- ===================== Aggiungi personalizzato ===================== -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.KeyBindings.AddCustomHeader}" Style="{StaticResource Text.Section}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{DynamicResource Str.KeyBindings.AddCustomInfo}"/>
                    <Button Content="{DynamicResource Str.KeyBindings.OpenReference}" Style="{StaticResource Btn.Base}"
                            HorizontalAlignment="Left" Margin="0,0,0,12" Command="{Binding ShowCommandReferenceCommand}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str.KeyBindings.DescriptionOptional}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str.KeyBindings.ColCommand}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str.KeyBindings.ColKey}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Str.KeyBindings.ColCategory}" Style="{StaticResource Text.Muted}" Margin="0,0,10,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" MaxLength="12" Margin="0,0,10,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding NewCategory}"
                                  Style="{StaticResource Input.ComboBox}" Margin="0,0,10,0"/>
                        <Button Grid.Row="1" Grid.Column="4" Content="{DynamicResource Str.KeyBindings.Add}" Style="{StaticResource Btn.Primary}" Command="{Binding AddCustomBindingCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic"
                               Text="{DynamicResource Str.KeyBindings.ChatHint}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
